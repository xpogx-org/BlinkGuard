# Cursor also honors .gitignore. Git still ignores these paths;
# `!` only re-includes them for chat, @ mentions, and indexing.
#
# Keep noise ignored (node_modules, dist, coverage, .vitest, logs, venv, .env,
# models, binaries, scratch). Do not add a blanket `*` here - that
# would hide the rest of the repo.

# Agent rules, skills, agents, hooks, commands, plans
!.cursor/
!.cursor/**

# Local SDD briefs / specs
!specs/
!specs/**
