{
	"name": "blinkguard",
	"private": true,
	"version": "2.18.0",
	"type": "module",
	"description": "Windows and macOS app that helps prevent dry eyes and eye strain: blink reminders, optional on-device camera detection, and 20-20-20 breaks. No account, no cloud.",
	"license": "MIT",
	"homepage": "https://github.com/xpogx-org/BlinkGuard",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xpogx-org/BlinkGuard.git"
	},
	"bugs": {
		"url": "https://github.com/xpogx-org/BlinkGuard/issues"
	},
	"author": {
		"name": "Pavlo Dzhevaha",
		"email": "pavel19.1078@gmail.com"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build && electron-builder --publish never",
		"build:electron": "tsc && vite build",
		"build:mac": "npm run build:electron && electron-builder --mac --config.mac.identity=null --config.mac.notarize=false --publish never && node scripts/remove-quarantine.js",
		"build:mac:clean": "npm run build:mac && node scripts/remove-quarantine.js --clean-dmg",
		"build:mac:publish": "node scripts/publish-mac.js",
		"build:windows": "node scripts/prepare-python-windows.js && tsc && vite build && electron-builder --win nsis --config.win.signExecutable=false --publish never",
		"build:windows:publish": "node scripts/publish-windows.js",
		"generate:installer-assets": "node scripts/generate-installer-assets.js",
		"generate:intro-video": "node scripts/intro_video/generate-intro-video.js",
		"remove-quarantine": "node scripts/remove-quarantine.js",
		"remove-quarantine:dmg": "node scripts/remove-quarantine.js --clean-dmg",
		"lint": "npx @biomejs/biome check --write src",
		"preview": "vite preview",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"coverage": "vitest run --coverage",
		"measure:size": "node scripts/measure-app-size.mjs"
	},
	"dependencies": {
		"@radix-ui/react-icons": "^1.3.0",
		"@radix-ui/react-slot": "^1.1.0",
		"class-variance-authority": "^0.7.0",
		"clsx": "^2.1.1",
		"electron-store": "^11.0.2",
		"electron-updater": "^6.8.9",
		"lottie-web": "^5.13.0",
		"lucide-react": "^1.41.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwind-merge": "^3.6.0",
		"tailwindcss-animate": "^1.0.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@electron/notarize": "^3.0.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^22.20.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/coverage-istanbul": "^5.0.0",
		"@vitest/ui": "^5.0.0",
		"dotenv": "^17.4.2",
		"electron": "^44.2.0",
		"electron-builder": "^26.15.3",
		"happy-dom": "^20.14.0",
		"postcss": "^8.5.28",
		"sharp": "^0.35.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vite-plugin-electron": "^1.1.2",
		"vitest": "^5.0.0"
	},
	"main": "dist-electron/main.js",
	"build": {
		"appId": "com.xpogx.blinkguard",
		"productName": "BlinkGuard",
		"publish": null,
		"artifactName": "${productName}-${arch}.${ext}",
		"electronLanguages": [
			"en-US",
			"uk"
		],
		"files": [
			"dist/**/*",
			"!dist/win-unpacked/**/*",
			"!dist/*.exe",
			"!dist/*.blockmap",
			"!dist/*.zip",
			"!dist/*.yml",
			"dist-electron/**/*",
			"electron/resources/**/*",
			"assets/icons/**/*",
			"build/**/*",
			"public/sounds/**/*"
		],
		"asarUnpack": [
			"electron/resources/**/*",
			"public/sounds/**/*"
		],
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "BlinkGuard",
			"installerIcon": "assets/icons/icon.ico",
			"uninstallerIcon": "assets/icons/icon.ico",
			"installerHeaderIcon": "assets/icons/icon.ico",
			"installerHeader": "build/installerHeader.bmp",
			"installerSidebar": "build/installerSidebar.bmp",
			"uninstallerSidebar": "build/uninstallerSidebar.bmp",
			"deleteAppDataOnUninstall": false,
			"displayLanguageSelector": false,
			"installerLanguages": [
				"en-US"
			],
			"language": "1033",
			"artifactName": "BlinkGuard.Setup.${ext}"
		},
		"mac": {
			"target": [
				"dmg",
				"zip"
			],
			"category": "public.app-category.utilities",
			"icon": "assets/icons/icon.icns",
			"hardenedRuntime": true,
			"gatekeeperAssess": false,
			"entitlements": "build/entitlements.mac.plist",
			"entitlementsInherit": "build/entitlements.mac.plist",
			"notarize": false,
			"extendInfo": {
				"NSUserNotificationAlertStyle": "alert"
			},
			"artifactName": "BlinkGuard-${arch}.${ext}"
		},
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				},
				"zip"
			],
			"icon": "assets/icons/icon.ico"
		}
	}
}
