# Model files (downloaded in CI / local setup; not committed)
electron/assets/models/shape_predictor_68_face_landmarks.dat
electron/assets/models/*.dat

# Blink detector binary (built during CI)
electron/resources/blink_detector
electron/resources/blink_detector.exe

# Stage-0 companion camera video (large MJPG AVI; keep local / AppData)
python/fixtures/sessions/*.avi
python/fixtures/sessions/*.ocec.ndjson
python/fixtures/sessions/*.ap.ndjson
python/fixtures/sessions/*.joined.ndjson
*.avi

# Blink JSONL agent probes — reusable tools live in python/log_tools/;
# keep one-offs out of git (and out of python/scripts/).
python/log_tools/_scratch/**
!python/log_tools/_scratch/README.md
python/scripts/_tmp_*.py
python/log_tools/_tmp_*.py

# README screenshot agent probes — reusable tools live in scripts/screenshot_tools/;
# keep one-offs out of git (and out of docs/screenshots/).
scripts/screenshot_tools/_scratch/**
!scripts/screenshot_tools/_scratch/README.md
docs/screenshots/_*.ps1
docs/screenshots/_*.png
docs/screenshots/_*.txt

# Intro-video intermediates — committed outputs live in docs/intro/
scripts/intro_video/_scratch/**
!scripts/intro_video/_scratch/README.md

